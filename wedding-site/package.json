{
  "name": "wedding-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/hooks.mjs --test \"tests/**/*.test.*\"",
    "deploy": "npx --yes vercel@63.1.2 pull --yes --environment=production && npx --yes vercel@63.1.2 build --prod && npx --yes vercel@63.1.2 deploy --prebuilt --prod",
    "art": "node scripts/sync-art.mjs",
    "fills": "node scripts/sync-fills.mjs",
    "photos": "sh scripts/prepare-photos.sh",
    "sheet:mock": "node scripts/sheet-mock.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
