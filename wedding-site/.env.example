# Public address of the site (optional). Used in the calendar event's description.
NEXT_PUBLIC_SITE_URL=

# --- Database (libSQL). Production: Turso from Vercel → Storage, which sets both. ---
# Leave empty locally: the dev server then uses .data/svadba.db (git-ignored).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Google Sheet mirror: the Apps Script web app (see google-sheet/SETUP.md) ---
# The Apps Script web app URL ending in /exec. Must be https in production.
RSVP_SHEET_URL=
# Long random string, identical to the RSVP_SECRET script property in Apps Script.
RSVP_SHEET_SECRET=
# Optional: the normal link to the spreadsheet, shown as „Otvoriť tabuľku“ in /admin.
RSVP_SHEET_VIEW_URL=

# --- Admin page (/admin) ---
# Password the couple types to sign in.
ADMIN_PASSWORD=
# Random string of at least 32 characters that signs the login cookie.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Never commit real values. Set them in Vercel → Settings → Environment Variables.
